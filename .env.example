# Copy to .env and fill in the values:  cp .env.example .env
SECRET_KEY=change-this-in-production

# Option 1: individual settings
DB_HOST=crud-app-postgresql.env-fpemontcg1
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-password-here

# Option 2: one connection URL (takes priority over the DB_* values)
# DATABASE_URL=postgresql://user:password@crud-app-postgresql.env-fpemontcg1:5432/dbname

# If no DB_HOST / DATABASE_URL is set, the app falls back to SQLite at DB_PATH
# DB_PATH=/data/app.db
